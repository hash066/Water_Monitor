{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run all SQL queries",
      "type": "shell",
      "command": "python run_queries.py",
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "python -m unittest test_queries.py -v",
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Run performance benchmark",
      "type": "shell",
      "command": "python benchmark.py",
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Start AquaTrace monitoring server",
      "type": "shell",
      "command": "python server.py",
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    }
  ]
}
